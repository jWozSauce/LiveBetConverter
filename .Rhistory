library(implied)
library(dplyr)
library(odds.converter)
valueNeeded = .05
overOrAwayOdds = -110
underOrHomeOdds = -110
odds <- c(overOrAwayOdds, underOrHomeOdds)
noVigOdds <- implied_probabilities(odds, method = "wpo", normalize = TRUE)
noVigOdds <- implied_probabilities(odds, method = "wpo")
